# ─── Jon & Katie Studio — environment config ───────────────────────────────
# Copy this file to `.env` and fill in your own values.
# All of these have FREE tiers. The first test is YouTube-only.

# --- Google Gemini (script + scene prompts + optional images) ---
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Voiceover (edge-tts needs NO key). Pick a voice + mode. ---
# Voices: en-US-AriaNeural (warm female), en-US-GuyNeural (warm male)
TTS_VOICE=en-US-AriaNeural
# narration mode: "narrate" (spoken vlog) or "silent" (captions + sfx only)
NARRATION_MODE=narrate

# --- Video generation backend ---
# "stub"   = no GPU, animate reference images (great for testing / first upload)
# "kaggle" = run LTX-2 on Kaggle free GPU (free HD upgrade)
# "local"  = you have a local GPU
VIDEO_BACKEND=stub
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- YouTube Data API (OAuth) ---
# Enable YouTube Data API v3 in Google Cloud (free), download client secret.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Upload targets & behaviour ---
# Where to post: "youtube" (default). Add "meta" later => "youtube,meta"
UPLOAD_TARGETS=youtube
# YouTube privacy for the run: "unlisted" (safe test), "public", or "private"
YOUTUBE_PRIVACY=unlisted
# "false" = publish immediately (testing). "true" = schedule to US peak times.
SCHEDULE_TO_PEAK=false

# --- Meta (Instagram Reels + Facebook Page) — OPTIONAL, add later ---
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# --- Posting / audience ---
# Primary US timezone to optimize peak posting time for (when SCHEDULE_TO_PEAK=true).
TARGET_TIMEZONE=America/New_York
CHANNEL_NAME=Jon & Katie
