# ─── Jon & Maddy Studio — environment config ───────────────────────────────
# Copy this file to `.env` and fill in your own values.
# All of these have FREE tiers.

# --- Google Gemini (script + scene prompts + optional images) ---
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Voiceover (edge-tts needs NO key). Pick a voice + mode. ---
# Voices: en-US-AriaNeural (warm female), en-US-GuyNeural (warm male)
TTS_VOICE=en-US-AriaNeural
# narration mode: "narrate" (spoken vlog) or "silent" (captions + sfx only)
NARRATION_MODE=narrate

# --- Video generation backend ---
# "kaggle" = run LTX-2 on Kaggle free GPU (recommended free)
# "local"  = you have a local GPU
# "stub"   = skip real gen, use placeholder clips (for testing the pipeline)
VIDEO_BACKEND=stub
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- YouTube Data API (OAuth) ---
# Enable YouTube Data API v3 in Google Cloud (free), download client secret.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- Meta (Instagram Reels + Facebook Page) ---
# Free with a Meta Business account + Graph API.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FB_PAGE_ID=

# --- Posting / audience ---
# Primary US timezone to optimize peak posting time for.
TARGET_TIMEZONE=America/New_York
CHANNEL_NAME=Jon & Katie
